# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Local Chrome profile used for screenshot runs
.chrome-profile/

# Verification screenshots and one-off dumps stay local; the repo ships code + written specs only
.local/
docs/*.png
docs/*.json

# Local-only tooling state (issue tracker root, agent scaffolding copies)
.scratch/
docs/agents/

# Editor / OS noise that keeps reappearing
*.bak-*
android/.kotlin/

# Android release signing (never commit the keystore or its passwords)
/android/key.properties
/android/*.jks
/android/*.keystore

# Built APKs live in dist/ locally; the repo ships source only
/dist/*.apk

# Gradle build output
/android/build/
/android/.gradle/

#distribution
/dist



# The challenge deliverable is a written artefact, keep it
!docs/challenge-s4-palette.png
