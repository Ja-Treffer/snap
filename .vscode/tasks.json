{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "flutter: analyze",
      "type": "shell",
      "command": "flutter analyze",
      "problemMatcher": ["$dart-analyzer"],
      "group": "test"
    },
    {
      "label": "flutter: test",
      "type": "shell",
      "command": "flutter test",
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "flutter: build web",
      "type": "shell",
      "command": "flutter build web --release",
      "problemMatcher": []
    },
    {
      "label": "flutter: run windows",
      "type": "shell",
      "command": "flutter run -d windows",
      "problemMatcher": [],
      "group": "build"
    }
  ]
}
